# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- General ----------------------------------------------------------------
ENVIRONMENT=development            # production enables Secure cookies, hides API docs
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Database ---------------------------------------------------------------
# Default: SQLite file at backend/data/marketlens.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/marketlens

# --- Scheduler --------------------------------------------------------------
RUN_SCHEDULER_IN_API=true          # false when running `python -m app.worker` separately
REFRESH_INTERVAL_MINUTES=30
RUN_ON_STARTUP_IF_STALE=true

# --- Market data ------------------------------------------------------------
PRICE_PROVIDER=yfinance
UNIVERSE_PROVIDER=nse_equity_list
MIN_MARKET_CAP_CR=1000
UNIVERSE_SERIES=EQ,BE
HISTORY_PERIOD=2y
DOWNLOAD_BATCH_SIZE=80
DOWNLOAD_THREADS=8
PROVIDER_MIN_INTERVAL_SECONDS=0.25
PROVIDER_MAX_RETRIES=4
SHARES_REFRESH_DAYS=7

# --- Pattern engine ---------------------------------------------------------
# Optional JSON file overriding detector thresholds (see backend/pattern-config.example.json)
# PATTERN_CONFIG_FILE=backend/pattern-config.json

# --- Passwords --------------------------------------------------------------
# Passwords are changed with the master password (set it with
# `python -m scripts.set_master_password`; only its hash is stored in the DB).
MASTER_MAX_FAILURES_PER_HOUR=10    # global cap on wrong master-password attempts
